{
  "schemaVersion": 1,
  "instanceId": "helpers.weather",
  "engineId": "sorting",
  "locales": [
    "en",
    "ar"
  ],
  "presentation": {
    "accent": "#4AC49A"
  },
  "narration": {
    "prompt": {
      "en": "Is it rainy or sunny? Put each thing where we use it.",
      "ar": "هَلِ اليَوْمُ مُمْطِرٌ أَمْ مُشْمِسٌ؟ ضَعْ كُلَّ شَيْءٍ فِي مَكَانِهِ."
    },
    "hint1": {
      "en": "Look at the picture. Where does it belong?",
      "ar": "اُنْظُرْ إِلَى الصُّورَةِ. أَيْنَ مَكَانُهَا؟"
    },
    "hint2": {
      "en": "Try the glowing picture.",
      "ar": "جَرِّبِ الصُّورَةَ المُضِيئَةَ."
    },
    "model": {
      "en": "Here is its home. Now you try!",
      "ar": "هَذَا مَكَانُهَا. جَرِّبْ أَنْتَ!"
    },
    "success": {
      "en": "All sorted! You are ready for rain or shine!",
      "ar": "رَتَّبْتَ كُلَّ شَيْءٍ! أَنْتَ جَاهِزٌ لِلْمَطَرِ وَالشَّمْسِ!"
    }
  },
  "payload": {
    "activeAttribute": "destination",
    "heldConstant": [
      "size"
    ],
    "itemsRef": "packs/helpers_weather",
    "itemsPerRound": 10,
    "roundCount": 1,
    "bins": [
      {
        "id": "rainy",
        "value": "rainy",
        "image": "assets/gen/images/helpers/rain.webp",
        "label": {
          "en": "Rainy day",
          "ar": "يَوْمٌ مُمْطِرٌ"
        }
      },
      {
        "id": "sunny",
        "value": "sunny",
        "image": "assets/gen/images/helpers/sun.webp",
        "label": {
          "en": "Sunny day",
          "ar": "يَوْمٌ مُشْمِسٌ"
        }
      }
    ]
  },
  "support": {
    "allowTapToSelect": true,
    "scaffolding": "errorless"
  },
  "adaptation": {
    "min": 10,
    "max": 10
  },
  "worksheet": {
    "prompt": {
      "en": "Rain or shine? Sort the pictures.",
      "ar": "مَطَرٌ أَمْ شَمْسٌ؟ رَتِّبِ الصُّوَرَ."
    },
    "retry": {
      "en": "Try the other box. You can do it!",
      "ar": "جَرِّبِ الصُّنْدُوقَ الآخَرَ. أَنْتَ تَسْتَطِيعُ!"
    },
    "correct": {
      "rainy": {
        "en": "Ready for a rainy day!",
        "ar": "جَاهِزٌ لِيَوْمٍ مُمْطِرٍ!"
      },
      "sunny": {
        "en": "Ready for a sunny day!",
        "ar": "جَاهِزٌ لِيَوْمٍ مُشْمِسٍ!"
      }
    }
  }
}
