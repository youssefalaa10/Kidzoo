{
  "schemaVersion": 1,
  "instanceId": "helpers.teeth",
  "engineId": "sorting",
  "locales": [
    "en",
    "ar"
  ],
  "presentation": {
    "accent": "#4AC49A"
  },
  "narration": {
    "prompt": {
      "en": "Put everyday foods by the happy tooth. Put sugary treats by the other tooth.",
      "ar": "ضَعِ الطَّعَامَ اليَوْمِيَّ عِنْدَ السِّنِّ السَّعِيدَةِ، وَالحَلْوَى عِنْدَ السِّنِّ الأُخْرَى."
    },
    "hint1": {
      "en": "Look at the picture. Where does it belong?",
      "ar": "اُنْظُرْ إِلَى الصُّورَةِ. أَيْنَ مَكَانُهَا؟"
    },
    "hint2": {
      "en": "Try the glowing picture.",
      "ar": "جَرِّبِ الصُّورَةَ المُضِيئَةَ."
    },
    "model": {
      "en": "Here is its home. Now you try!",
      "ar": "هَذَا مَكَانُهَا. جَرِّبْ أَنْتَ!"
    },
    "success": {
      "en": "All the foods are sorted! What a happy smile!",
      "ar": "رَتَّبْتَ كُلَّ الطَّعَامِ! يَا لَهَا مِنِ ابْتِسَامَةٍ سَعِيدَةٍ!"
    }
  },
  "payload": {
    "activeAttribute": "destination",
    "heldConstant": [
      "size"
    ],
    "itemsRef": "packs/helpers_teeth",
    "itemsPerRound": 10,
    "roundCount": 1,
    "bins": [
      {
        "id": "treat",
        "value": "treat",
        "image": "assets/gen/images/helpers/sad_tooth.webp",
        "label": {
          "en": "Sugary treats",
          "ar": "حَلْوَى"
        }
      },
      {
        "id": "everyday",
        "value": "everyday",
        "image": "assets/gen/images/helpers/tooth.webp",
        "label": {
          "en": "Everyday foods",
          "ar": "طَعَامٌ يَوْمِيٌّ"
        }
      }
    ]
  },
  "support": {
    "allowTapToSelect": true,
    "scaffolding": "errorless"
  },
  "adaptation": {
    "min": 10,
    "max": 10
  },
  "worksheet": {
    "prompt": {
      "en": "Drag each food to its tooth.",
      "ar": "اِسْحَبْ كُلَّ طَعَامٍ إِلَى السِّنِّ المُنَاسِبَةِ."
    },
    "retry": {
      "en": "Try the other box. You can do it!",
      "ar": "جَرِّبِ الصُّنْدُوقَ الآخَرَ. أَنْتَ تَسْتَطِيعُ!"
    },
    "correct": {
      "everyday": {
        "en": "An everyday food. Well done!",
        "ar": "طَعَامٌ يَوْمِيٌّ. أَحْسَنْتَ!"
      },
      "treat": {
        "en": "A sugary treat. Just sometimes.",
        "ar": "حَلْوَى مُحَلَّاةٌ. نَأْكُلُهَا أَحْيَانًا."
      }
    }
  }
}
