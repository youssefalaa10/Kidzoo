{
  "schemaVersion": 1,
  "instanceId": "helpers.laundry",
  "engineId": "sorting",
  "locales": [
    "en",
    "ar"
  ],
  "presentation": {
    "accent": "#4AC49A"
  },
  "narration": {
    "prompt": {
      "en": "Dirty clothes go to the washer. Clean clothes go to the wardrobe.",
      "ar": "ضَعِ المَلَابِسَ المُتَّسِخَةَ فِي الغَسَّالَةِ، وَالنَّظِيفَةَ فِي الخِزَانَةِ."
    },
    "hint1": {
      "en": "Look at the picture. Where does it belong?",
      "ar": "اُنْظُرْ إِلَى الصُّورَةِ. أَيْنَ مَكَانُهَا؟"
    },
    "hint2": {
      "en": "Try the glowing picture.",
      "ar": "جَرِّبِ الصُّورَةَ المُضِيئَةَ."
    },
    "model": {
      "en": "Here is its home. Now you try!",
      "ar": "هَذَا مَكَانُهَا. جَرِّبْ أَنْتَ!"
    },
    "success": {
      "en": "All sorted! The clean clothes have a tidy home!",
      "ar": "رَتَّبْتَ كُلَّ شَيْءٍ! المَلَابِسُ النَّظِيفَةُ فِي مَكَانِهَا!"
    }
  },
  "payload": {
    "activeAttribute": "destination",
    "heldConstant": [
      "size"
    ],
    "itemsRef": "packs/helpers_laundry",
    "itemsPerRound": 10,
    "roundCount": 1,
    "bins": [
      {
        "id": "dirty",
        "value": "dirty",
        "image": "assets/gen/images/helpers/washer.webp",
        "label": {
          "en": "Needs washing",
          "ar": "يَحْتَاجُ إِلَى الغَسِيلِ"
        }
      },
      {
        "id": "clean",
        "value": "clean",
        "image": "assets/gen/images/helpers/wardrobe.webp",
        "label": {
          "en": "Clean and ready",
          "ar": "نَظِيفٌ وَجَاهِزٌ"
        }
      }
    ]
  },
  "support": {
    "allowTapToSelect": true,
    "scaffolding": "errorless"
  },
  "adaptation": {
    "min": 10,
    "max": 10
  },
  "worksheet": {
    "prompt": {
      "en": "Sort the dirty and clean clothes.",
      "ar": "رَتِّبِ المَلَابِسَ المُتَّسِخَةَ وَالنَّظِيفَةَ."
    },
    "retry": {
      "en": "Try the other box. You can do it!",
      "ar": "جَرِّبِ الصُّنْدُوقَ الآخَرَ. أَنْتَ تَسْتَطِيعُ!"
    },
    "correct": {
      "dirty": {
        "en": "These clothes need washing.",
        "ar": "هَذِهِ المَلَابِسُ تَحْتَاجُ إِلَى الغَسِيلِ."
      },
      "clean": {
        "en": "Clean clothes go in the wardrobe.",
        "ar": "المَلَابِسُ النَّظِيفَةُ فِي الخِزَانَةِ."
      }
    }
  }
}
