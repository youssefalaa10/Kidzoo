<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Story reminders ("let's continue the story"). Runtime-requested on
         Android 13+, and only after the child has actually started a story:
         see StoryReminderPlanner, which says nothing at all to someone who has
         never opened an Adventure. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets a scheduled reminder survive a reboot. Deliberately NOT
         SCHEDULE_EXACT_ALARM: reminders are inexact by design, because
         "around six in the evening" is good enough and an exact alarm needs a
         special-access permission the app should not be asking a parent for. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Kidzo has no photo or video picker. Avatars are four bundled assets in
         ImageManager.kidAvatars, selected by index and stored as Profiles.avatarIndex
         (an int), so the app never reads the user's media library and needs no
         media permission. The three removals below are deliberate regression guards:
         they are no-ops today because nothing declares these permissions, but if a
         future plugin re-introduces them through manifest merging the merge strips
         them again, so the Google Play "use alternative system pickers" policy flag
         cannot silently come back. Do not delete them as dead code. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <application
        android:label="kidzo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Re-registers scheduled story reminders after a reboot or an app
             update; without these a pending reminder is silently dropped. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ (package visibility) for the app to see any
             text-to-speech engine at all. Without it getEngines/getVoices come
             back empty and setEngine silently fails, so no Arabic voice can be
             discovered or selected. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Required for TTS language data installation checks -->
        <intent>
            <action android:name="android.speech.tts.engine.CHECK_TTS_DATA"/>
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA"/>
        </intent>
    </queries>
</manifest>
